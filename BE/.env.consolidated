# Consolidated Environment Variables for All Services
# Generated from all application.yml files in the backend services
# This file contains all environment variables used across the system

# ============================================
# COMMON DATABASE CONFIGURATION
# ============================================
# Each service uses its own database, but these are common connection settings
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=password

# Service-specific database URLs (each service has its own database)
# Auth Service
SPRING_DATASOURCE_URL_AUTH=jdbc:postgresql://localhost:5432/auth_db
# User Service
SPRING_DATASOURCE_URL_USER=jdbc:postgresql://localhost:5432/user_db
# Product Service
SPRING_DATASOURCE_URL_PRODUCT=jdbc:postgresql://localhost:5432/product_db
# Cart Service
SPRING_DATASOURCE_URL_CART=jdbc:postgresql://localhost:5432/cart_db
# Order Service
SPRING_DATASOURCE_URL_ORDER=jdbc:postgresql://localhost:5432/order_db
# Payment Service
SPRING_DATASOURCE_URL_PAYMENT=jdbc:postgresql://localhost:5432/payment_db
# Notification Service
SPRING_DATASOURCE_URL_NOTIFICATION=jdbc:postgresql://localhost:5432/notification_db
# AI Agent Service
SPRING_DATASOURCE_URL_AI=jdbc:postgresql://localhost:5432/ai_db

# ============================================
# SERVICE PORTS
# ============================================
SERVER_PORT_AUTH=8081
SERVER_PORT_USER=8082
SERVER_PORT_PRODUCT=8083
SERVER_PORT_AI=8085
SERVER_PORT_CART=8086
SERVER_PORT_ORDER=8087
SERVER_PORT_PAYMENT=8088
SERVER_PORT_NOTIFICATION=8089
SERVER_PORT_GATEWAY=3001

# ============================================
# SERVICE URLs (for inter-service communication)
# ============================================
AUTH_SERVICE_URL=http://localhost:8081
USER_SERVICE_URL=http://localhost:8082
PRODUCT_SERVICE_URL=http://localhost:8083
AI_SERVICE_URL=http://localhost:8085
CART_SERVICE_URL=http://localhost:8086
ORDER_SERVICE_URL=http://localhost:8087
PAYMENT_SERVICE_URL=http://localhost:8088
NOTIFICATION_SERVICE_URL=http://localhost:8089

# ============================================
# REDIS CONFIGURATION (API Gateway)
# ============================================
REDIS_HOST=localhost
REDIS_PORT=6379

# ============================================
# JWT CONFIGURATION
# ============================================
JWT_SECRET=super-secure-stylemind-secret-key-signature-2026-xyz
JWT_ACCESS_TOKEN_EXPIRATION=3600000
JWT_REFRESH_TOKEN_EXPIRATION=86400000

# ============================================
# INTERNAL SERVICE TOKEN
# ============================================
X_INTERNAL_TOKEN=sm-secret-internal-service-token-key-2026

# ============================================
# MAIL/NOTIFICATION CONFIGURATION
# ============================================
SPRING_MAIL_HOST=smtp.gmail.com
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=
SPRING_MAIL_PASSWORD=
SPRING_MAIL_PROPERTIES_MAIL_SMTP_AUTH=true
SPRING_MAIL_PROPERTIES_MAIL_SMTP_STARTTLS_ENABLE=true
MAIL_ENABLED=true
APP_MAIL_FROM_ADDRESS=
APP_MAIL_FROM_NAME=StyleMind
MAIL_LOG_FALLBACK=true

# ============================================
# CLOUDINARY CONFIGURATION (Product Service)
# ============================================
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=stylemind/products

# ============================================
# SEPAY/VIETQR CONFIGURATION (Payment Service)
# ============================================
SEPAY_BANK_SHORT_NAME=
SEPAY_ACCOUNT_NUMBER=
SEPAY_ACCOUNT_NAME=
SEPAY_BANK_HUB_PREFIX=SEVQR
SEPAY_PAYMENT_EXPIRE_MINUTES=15
SEPAY_QR_BASE_URL=https://img.vietqr.io/image
SEPAY_ENABLED=true
SEPAY_MODE=live
SEPAY_PAYMENT_CODE_PREFIX=STYLEMIND
SEPAY_WEBHOOK_AUTH_MODE=API_KEY
SEPAY_WEBHOOK_API_KEY=

# ============================================
# AUTH-SPECIFIC CONFIGURATION
# ============================================
APP_FRONTEND_BASE_URL=http://localhost:5173
AUTH_SETUP_TOKEN_EXPIRY_MINUTES=1440
AUTH_RESET_OTP_EXPIRY_MINUTES=10
AUTH_RESET_TOKEN_EXPIRY_MINUTES=30
AUTH_RESET_OTP_MAX_ATTEMPTS=5
AUTH_RESET_OTP_RESEND_COOLDOWN_SECONDS=60
AUTH_REGISTER_OTP_EXPIRY_MINUTES=10
AUTH_REGISTER_OTP_MAX_ATTEMPTS=5
AUTH_REGISTER_OTP_RESEND_COOLDOWN_SECONDS=60

# ============================================
# ORDER-SPECIFIC CONFIGURATION
# ============================================
ORDER_PAYMENT_TIMEOUT_MINUTES=15
ORDER_TIMEOUT_JOB_INTERVAL_MS=300000

# ============================================
# PRODUCT-SPECIFIC CONFIGURATION
# ============================================
PRODUCT_DEFAULT_CURRENCY=VND
