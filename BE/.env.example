# Security
JWT_SECRET=super-secure-stylemind-secret-key-signature-2026-xyz
X_INTERNAL_TOKEN=internal-service-token-2026

# SePay - the API key SePay sends as "Authorization: Apikey <this>" on every
# webhook call (configured in the SePay dashboard for your integration). Payment
# webhooks are rejected unless this matches. Use a SePay sandbox/test account
# value in dev; only use a real one for the demo.
SEPAY_WEBHOOK_API_KEY=sepay-sandbox-webhook-key-2026

# External Services
LLM_API_KEY=your-llm-api-key-here
