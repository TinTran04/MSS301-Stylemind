# Security
JWT_PRIVATE_KEY_PATH=/app/certs/private_key.pem
JWT_PUBLIC_KEY_PATH=/app/certs/public_key.pem
X_INTERNAL_TOKEN=internal-service-token-2026

# SePay - the API key SePay sends as "Authorization: Apikey <this>" on every
# webhook call (configured in the SePay dashboard for your integration). Payment
# webhooks are rejected unless this matches. Use a SePay sandbox/test account
# value in dev; only use a real one for the demo.
SEPAY_WEBHOOK_API_KEY=replace-with-sepay-webhook-api-key
SEPAY_BANK_SHORT_NAME=970415
SEPAY_ACCOUNT_NUMBER=replace-with-sepay-account-number
SEPAY_ACCOUNT_NAME=replace-with-sepay-account-name
SEPAY_BANK_HUB_PREFIX=SEVQR
SEPAY_PAYMENT_CODE_PREFIX=STYLEMIND
SEPAY_ENABLED=true
SEPAY_MODE=live

# Email sender display (notification-service)
# APP_MAIL_FROM_NAME is the display name recipients see, e.g. "StyleMind <account@gmail.com>".
# APP_MAIL_FROM_ADDRESS is optional; leave it blank to default to SPRING_MAIL_USERNAME
# (the authenticated Gmail account). Do NOT put the Gmail app password here.
APP_MAIL_FROM_NAME=StyleMind
APP_MAIL_FROM_ADDRESS=

# External Services
LLM_API_KEY=your-llm-api-key-here

# Cloudinary product images (backend only; never expose API_SECRET to Vite)
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret
CLOUDINARY_FOLDER=stylemind/products
