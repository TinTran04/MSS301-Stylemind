# JWT Asymmetric Key Configuration
# Internal container paths for Docker volume mounting
JWT_PRIVATE_KEY_PATH=/app/certs/private_key.pem
JWT_PUBLIC_KEY_PATH=/app/certs/public_key.pem
JWT_ALGORITHM=RSA
JWT_KEY_SIZE=2048
JWT_ACCESS_TOKEN_EXPIRATION=3600000
JWT_REFRESH_TOKEN_EXPIRATION=604800000

# Internal Service Token
X_INTERNAL_TOKEN=stylemind-test-internal-token
